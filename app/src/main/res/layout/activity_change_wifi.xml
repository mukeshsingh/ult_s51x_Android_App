<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:context=".ChangeWifiActivity"
    android:background="@color/white">
    <include
        android:id="@+id/toolbar"
        layout="@layout/user_header"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingBottom="25dp"
        android:layout_below="@+id/toolbar"
        android:layout_above="@+id/footer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="0dp">
            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/wifi"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/wifi"
                android:layout_gravity="center_horizontal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi"
                android:textSize="18sp"
                android:gravity="center"
                android:fontFamily="@font/lato_bold"
                android:textColor="@android:color/black"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/wifiConnectedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_is_not_connected"
                android:textSize="16sp"
                android:gravity="center"
                android:fontFamily="@font/lato_bold"
                android:textColor="@android:color/holo_red_dark"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp" />

            <!-- State 1: Scan WiFi Button (Not Connected State) -->
            <LinearLayout
                android:id="@+id/llScanWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <Button
                    android:id="@+id/btn_scan_wifi"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_wifi"
                    android:textSize="18sp"
                    android:paddingHorizontal="40dp"
                    android:layout_marginTop="20dp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_button_green_bg"
                    app:backgroundTint="#99CC33"/>
            </LinearLayout>

            <!-- State 2: Choose WiFi Network (After Scan) -->
            <LinearLayout
                android:id="@+id/llChooseWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_wifi_network"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:fontFamily="@font/lato_bold"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <com.ultrontech.s515liftconfigure.wheelpicker.LoopView
                    android:id="@+id/loopViewWifi"
                    android:layout_width="200dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="0dp"
                    android:layout_gravity="center_horizontal" />

                <Button
                    android:id="@+id/btn_connect_wifi"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_btn"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_button_green_bg"
                    app:backgroundTint="#99CC33"
                    android:layout_gravity="center_horizontal"/>

                <Button
                    android:id="@+id/btn_enter_manually"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_manually"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_button_green_bg"
                    app:backgroundTint="#808080"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>

            <!-- State 3: Password Entry -->
            <LinearLayout
                android:id="@+id/llPasswordEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_name"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:fontFamily="@font/lato_bold"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/edt_wifi_ssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:autofillHints=""
                    android:hint="@string/name"
                    android:textColorHint="@color/lightGrey"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lato_regular"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_outline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_password"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:fontFamily="@font/lato_bold"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/edt_wifi_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:autofillHints=""
                    android:hint="@string/password"
                    android:textColorHint="@color/lightGrey"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lato_regular"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_outline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_security"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:fontFamily="@font/lato_bold"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp" />

                <com.ultrontech.s515liftconfigure.wheelpicker.LoopView
                    android:id="@+id/loopViewSecurity"
                    android:layout_width="200dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_horizontal" />

                <Button
                    android:id="@+id/btn_connect_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_btn"
                    android:textSize="18sp"
                    android:paddingHorizontal="40dp"
                    android:layout_marginTop="20dp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_button_green_bg"
                    app:backgroundTint="#99CC33"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>

            <!-- State 4: Connected State -->
            <LinearLayout
                android:id="@+id/llConnectedState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_connected_wifi_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:gravity="center"
                    android:fontFamily="@font/lato_regular"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btn_edit_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_edit"
                    android:textSize="18sp"
                    android:paddingHorizontal="50dp"
                    android:layout_marginTop="300dp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_button_green_bg"
                    app:backgroundTint="#99CC33"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include android:id="@+id/footer"
        layout="@layout/home_back_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentBottom="true"/>
    <include
        android:id="@+id/option_menu"
        layout="@layout/option_menu" />
    <include android:id="@+id/loader"
        layout="@layout/loader_view" />
</RelativeLayout>
